# Backend S3 para a AWS REAL (passo opcional; exige aprovação explícita e guardrails do plano v0.2).
# Copie para backend-aws.hcl (gitignored) e ajuste o bucket criado pela stack 00-backend com TARGET=aws.
bucket       = "argus-platform-lab-tfstate-<sufixo-unico>"
region       = "us-east-1"
use_lockfile = true   # lock nativo do S3 (Terraform >= 1.10) — sem DynamoDB
encrypt      = true
