# Backend S3 da AWS REAL (copiar para envs/real/backend.hcl e platform/terraform/_shared/backend-aws.hcl; ambos gitignored)
bucket       = "argus-platform-lab-tfstate-<sufixo-unico>"
region       = "us-east-1"
use_lockfile = true # lock nativo do S3 (Terraform >= 1.10), sem DynamoDB
encrypt      = true
