{
  "_doc": "Perfil free: servidores locais apontando para o floci (AWS emulada). Documentação AWS e skills vêm do plugin aws-core (Agent Toolkit for AWS), instalado no escopo de usuário.",
  "mcpServers": {
    "terraform": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:1.4.1"
      ]
    },
    "aws-api-floci": {
      "command": "uvx",
      "args": [
        "awslabs.aws-api-mcp-server@1.6.0"
      ],
      "env": {
        "AWS_ENDPOINT_URL": "http://localhost.floci.io:4566",
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "eks-floci": {
      "command": "uvx",
      "args": [
        "awslabs.eks-mcp-server@0.2.1",
        "--allow-write"
      ],
      "env": {
        "AWS_ENDPOINT_URL": "http://localhost.floci.io:4566",
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
